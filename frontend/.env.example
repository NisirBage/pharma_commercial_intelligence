# Copy to .env.local (gitignored) for local development overrides.
# Vite only exposes variables prefixed VITE_ to client code.

# Base URL of the M6 FastAPI backend. Defaults to http://localhost:8000
# in code (see src/api/client.ts) if this is unset, so this file exists
# for documentation and for overriding in non-default setups.
VITE_API_BASE_URL=http://localhost:8000

# Copy this file to .env (repo root) and fill in real values for local
# development. .env is gitignored — never commit real credentials.

# --- Database (optional — the API and analytics layer fall back to
#     re-deriving the canonical frame from data/raw/*.csv when no
#     database is reachable; see docs/optimization-methodology.md and
#     app/analytics/data_access.py) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharma_ci
POSTGRES_USER=pharma_ci
POSTGRES_PASSWORD=changeme
# Alternatively, set the full URL directly (takes precedence over the POSTGRES_* values above):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- API ---
ENVIRONMENT=development
API_VERSION=1.0.0
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins — never "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Data paths (defaults are usually fine; override only if relocating data/) ---
# RAW_DATA_DIR=./data/raw
# QUALITY_REPORT_DIR=./backend/data/quality_reports
